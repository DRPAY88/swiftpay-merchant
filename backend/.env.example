PORT=3000
SWIFTPAY_BASE_URL=https://api.pay.sandbox.live.swiftpay.ph/api/
SWIFTPAY_ACCESS_KEY=replace-with-your-32-character-sandbox-access-key
SWIFTPAY_SECRET_KEY=replace-with-your-32-character-sandbox-secret-key
SWIFTPAY_ALLOW_LIVE=false

# Use a random value of at least 32 bytes. Only allow merchant operator emails.
SESSION_SIGNING_KEY=replace-with-a-random-secret-at-least-32-bytes-long
AUTH_ALLOWED_EMAILS=merchant@example.com,support@example.com
AUTH_ADDITIONAL_ALLOWED_EMAILS=
SUPER_ADMIN_EMAILS=support@swiftpay.site
DATABASE_URL=postgresql://swiftpay_merchant:replace-me@localhost:5432/swiftpay_merchant
RESEND_API_KEY=replace-with-your-resend-api-key
OTP_FROM_EMAIL=SwiftPay <login@swiftpay.site>