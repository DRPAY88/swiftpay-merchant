PORT=3000
PUBLIC_BASE_URL=https://swiftpay-merchant.onrender.com
SWIFTPAY_BASE_URL=https://api.pay.sandbox.live.swiftpay.ph/api/
SWIFTPAY_ACCESS_KEY=replace-with-your-32-character-sandbox-access-key
SWIFTPAY_SECRET_KEY=replace-with-your-32-character-sandbox-secret-key
SWIFTPAY_ALLOW_LIVE=false

# Use a random value of at least 32 bytes. Only allow merchant operator emails.
SESSION_SIGNING_KEY=replace-with-a-random-secret-at-least-32-bytes-long
AUTH_ALLOWED_EMAILS=merchant@example.com,support@example.com
AUTH_ADDITIONAL_ALLOWED_EMAILS=
SUPER_ADMIN_EMAILS=support@swiftpay.site
DATABASE_URL=postgresql://swiftpay_merchant:replace-me@localhost:5432/swiftpay_merchant
RESEND_API_KEY=replace-with-your-resend-api-key
OTP_FROM_EMAIL=SwiftPay <login@swiftpay.site>

# CurrencyAPI paid commercial plan for KRW-facing PHP QR quotes; keep this key server-side.
CURRENCYAPI_KEY=

# Firebase service-account JSON for verified incoming-payment push notifications.
# Store the full JSON value as a backend secret; never put it in the Android app.
FCM_SERVICE_ACCOUNT_JSON=

# Transak hosted PHP/USDT TRON checkout; keep the secret only in the backend secret store.
# Production must only be used after the Transak merchant account is enabled for PHP/Philippines and TRON,
# the static egress IP is allowlisted, and the live API credentials are inserted in the deployment environment.
TRANSAK_ENVIRONMENT=production
TRANSAK_API_KEY=
TRANSAK_API_SECRET=